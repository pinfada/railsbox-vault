{
  "name": "railsbox-vault",
  "version": "0.1.0",
  "description": "Des logiciels Rails distribués par le web, exécutés et possédés localement.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:browser": "playwright test",
    "test:compat": "playwright test --config playwright.compat.config.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=22.13 <25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
