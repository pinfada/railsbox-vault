<h2>Notes</h2>

<% if @refus %>
  <p id="refus" role="alert"><%= @refus %></p>
<% end %>

<%# Un formulaire ORDINAIRE : méthode POST, jeton anti-CSRF, et rien d'autre.
    C'est ce que `form_with` produit sans configuration, et c'est ce que le
    relais doit franchir sans que l'application sache qu'elle est relayée.
    En multipart depuis #209 : une pièce jointe facultative accompagne la note. %>
<%= form_with url: notes_path, method: :post, id: "formulaire-note", multipart: true do |f| %>
  <%= f.label :libelle, "Libellé" %>
  <%= f.text_field :libelle, id: "libelle" %>
  <%= f.label :piece, "Pièce jointe" %>
  <%= f.file_field :piece, id: "piece" %>
  <%= f.submit "Enregistrer", id: "enregistrer" %>
<% end %>

<ul id="notes">
  <% @notes.each do |note| %>
    <li><a href="<%= note_path(note) %>" data-note="<%= note.id %>"><%= note.label %></a></li>
  <% end %>
</ul>

<p id="compte-notes"><%= @notes.size %></p>

<%# L'état du disque de données relevé par l'init au montage (revue #211, 5) :
    ce qu'un scénario de boot à froid exige, un disque sans erreur. %>
<% if @disque %>
  <p id="etat-du-disque" data-disque-releve="oui" data-disque-options="<%= @disque["options"] %>" data-disque-erreurs="<%= @disque["erreurs"] %>" data-disque-alertes="<%= @disque["alertes"] %>" data-disque-rejeu="<%= @disque["rejeu"] %>">disque de données : <%= @disque["erreurs"] %> erreur(s)</p>
<% else %>
  <p id="etat-du-disque" data-disque-releve="non">disque de données : état non relevé</p>
<% end %>
