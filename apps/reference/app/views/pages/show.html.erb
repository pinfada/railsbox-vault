<h2 id="libelle-note"><%= @note.label %></h2>
<p id="identifiant-note"><%= @note.id %></p>
<p id="sequence-note"><%= @note.sequence %></p>
<%# Version 1.1.0 (#236 T2) : la colonne ajoutée par la migration, relue sur une note d'avant. %>
<p id="commentaire-note" data-colonne="commentaire"><%= @note.commentaire.presence || "(aucun commentaire)" %></p>
<% if @refus %>
  <p id="refus" role="alert"><%= @refus %></p>
<% end %>
<%# Le champ qui l'ÉCRIT (recette QA de la PR #249, Q9) : PATCH, jeton anti-CSRF, échappement par
    défaut du gabarit à la relecture. %>
<%= form_with scope: :note, url: note_path(@note), method: :patch, id: "formulaire-commentaire" do |f| %>
  <%= f.label :commentaire, "Commentaire" %>
  <%= f.text_field :commentaire, id: "commentaire", maxlength: 200, value: @note.commentaire %>
  <%= f.submit "Enregistrer le commentaire", id: "enregistrer-commentaire" %>
<% end %>
<%# La pièce est RELUE depuis le stockage, et son empreinte calculée sur ce qui a
    été lu : un nom de fichier survivant sans ses octets ne se lirait pas ici. %>
<% if @piece&.key?(:sha256) %>
  <p id="piece-note" data-piece-octets="<%= @piece[:octets] %>" data-piece-sha256="<%= @piece[:sha256] %>"><%= @piece[:nom] %></p>
<% elsif @piece %>
  <p id="piece-note" data-piece-etat="fichier-introuvable"><%= @piece[:nom] %></p>
<% end %>
<p><a href="/" id="retour">Retour</a></p>
