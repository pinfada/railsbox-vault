        <mxCell id="autre_v2" value="&lt;b&gt;Restauration d'une archive&lt;/b&gt; sur une autre origine — prouvée de bout en bout pour un volume v2 (E2E, deux origines, boot à froid hors ligne)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBE8F4;strokeColor=#2F6497;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="autre">
