        <object id="publication" label="&lt;div style=&quot;font-size:20px;line-height:1.15;font-weight:bold&quot;&gt;Distribution statique&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.2;margin-top:6px;color:#2457A7&quot;&gt;HÉBERGEMENT WEB&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.25;margin-top:10px;color:#526581&quot;&gt;Coquille et artefacts&lt;br&gt;vérifiés par empreinte.&lt;/div&gt;" tooltip="Deux arbres de publication, un par origine. Le dépôt fournit les outils ; le déploiement réel reste à prouver. Les artefacts de l’image sont déposés séparément (ADR 0030, 0041).">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#C7D4E5;strokeWidth=1.3;" vertex="1" parent="1">
            <mxGeometry x="64" y="310" width="248" height="140" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="user" value="&lt;div style=&quot;font-size:20px;line-height:1.15;font-weight:bold&quot;&gt;Utilisateur&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.2;margin-top:6px;color:#2457A7&quot;&gt;PERSONNE&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.25;margin-top:10px;color:#526581&quot;&gt;Ouvre, travaille,&lt;br&gt;verrouille et sauvegarde.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#C7D4E5;strokeWidth=1.3;" vertex="1" parent="1">
          <mxGeometry x="64" y="555" width="248" height="145" as="geometry" />
        </mxCell>
        <object id="shell" label="&lt;div style=&quot;font-size:20px;line-height:1.15;font-weight:bold&quot;&gt;Coquille&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.2;margin-top:6px;color:#2457A7&quot;&gt;INTERFACE WEB&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.25;margin-top:10px;color:#526581&quot;&gt;Ouverture et récupération.&lt;br&gt;Parcours et cycle de vie.&lt;/div&gt;" tooltip="public/index.html, public/main.mjs, src/coquille/. Preuve de la feuille constatée par le Worker ; réouverture de routine vers l’application ; révocation facultative et avertissement selon le moyen de la séance (ADR 0040, amendements des 18–19 septembre).">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#C7D4E5;strokeWidth=1.3;" vertex="1" parent="1">
            <mxGeometry x="412" y="340" width="280" height="145" as="geometry" />
          </mxCell>
        </object>
        <object id="worker" label="&lt;div style=&quot;font-size:20px;line-height:1.15;font-weight:bold&quot;&gt;Runtime de confiance&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.2;margin-top:6px;color:#2457A7&quot;&gt;WORKER DÉDIÉ&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.25;margin-top:10px;color:#526581&quot;&gt;Clés, volumes et reprise.&lt;br&gt;Accès exclusif au stockage.&lt;/div&gt;" tooltip="Le handle OPFS ne quitte jamais le Worker. HKDF dérive les clés par domaine ; la clé maîtresse n’est pas utilisée directement par AES-GCM. Barrières de durabilité et générations transactionnelles (ADR 0033–0036).">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#C7D4E5;strokeWidth=1.3;" vertex="1" parent="1">
            <mxGeometry x="412" y="565" width="280" height="145" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="frame" value="&lt;div style=&quot;font-size:20px;line-height:1.15;font-weight:bold&quot;&gt;Interface Rails&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.2;margin-top:6px;color:#7053A6&quot;&gt;IFRAME SANDBOXÉE&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.25;margin-top:10px;color:#526581&quot;&gt;Affiche les pages Rails.&lt;br&gt;Aucun accès aux clés.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#D9CEEA;strokeWidth=1.3;" vertex="1" parent="1">
          <mxGeometry x="1200" y="340" width="304" height="145" as="geometry" />
        </mxCell>
        <object id="relay" label="&lt;div style=&quot;font-size:20px;line-height:1.15;font-weight:bold&quot;&gt;Relais applicatif&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.2;margin-top:6px;color:#7053A6&quot;&gt;SERVICE WORKER&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.25;margin-top:10px;color:#526581&quot;&gt;Transmet les requêtes HTTP&lt;br&gt;au Worker de confiance.&lt;/div&gt;" tooltip="Relais par MessagePort et troisième canal du Worker de confiance. La session Rails reste dans le Worker. Ni WebSocket ni EventSource relayés (ADR 0038).">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#D9CEEA;strokeWidth=1.3;" vertex="1" parent="1">
            <mxGeometry x="1200" y="565" width="304" height="145" as="geometry" />
          </mxCell>
        </object>
        <object id="vm" label="&lt;div style=&quot;font-size:20px;line-height:1.15;font-weight:bold&quot;&gt;Application Rails&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.2;margin-top:6px;color:#2457A7&quot;&gt;V86 · LINUX · RUBY&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.25;margin-top:10px;color:#526581&quot;&gt;Exécution locale en WebAssembly.&lt;/div&gt;" tooltip="Le HTTP passe par le port série de la VM, sans réseau applicatif. hda est composé en RAM ; la VM lit hdb par l’adaptateur de blocs relié au Worker.">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#C7D4E5;strokeWidth=1.3;" vertex="1" parent="1">
            <mxGeometry x="800" y="565" width="280" height="145" as="geometry" />
          </mxCell>
        </object>
        <object id="opfs" label="&lt;div style=&quot;font-size:18px;line-height:1.15;font-weight:bold&quot;&gt;Volumes chiffrés&lt;/div&gt;&lt;div style=&quot;font-size:11px;line-height:1.2;margin-top:4px;color:#2457A7&quot;&gt;OPFS · ORIGINE DE CONFIANCE&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.25;margin-top:6px;color:#526581&quot;&gt;Données + instantané de reprise.&lt;/div&gt;" tooltip="Volume v4, journal .gen, .manifest, .temoin, .cles, .instantane, .migration et engagement de restauration. Export RBVAULT1 v3. Les détails et limites de rejeu figurent dans SECURITY.md et les ADR 0034–0036.">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#C7D4E5;strokeWidth=1.3;" vertex="1" parent="1">
            <mxGeometry x="412" y="765" width="280" height="105" as="geometry" />
          </mxCell>
        </object>
        <object id="archive" label="&lt;div style=&quot;font-size:18px;line-height:1.15;font-weight:bold&quot;&gt;Sauvegarde portable&lt;/div&gt;&lt;div style=&quot;font-size:11px;line-height:1.2;margin-top:4px;color:#2457A7&quot;&gt;FICHIER UTILISATEUR&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.25;margin-top:6px;color:#526581&quot;&gt;Archive chiffrée + récupération.&lt;/div&gt;" tooltip="Export puis restauration sur un autre appareil ou une autre origine. Sans tous les moyens d’ouverture, aucun séquestre ne permet la récupération.">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#C7D4E5;strokeWidth=1.3;" vertex="1" parent="1">
            <mxGeometry x="64" y="765" width="248" height="105" as="geometry" />
          </mxCell>
        </object>
        <object id="disks" label="&lt;div style=&quot;font-size:18px;line-height:1.15;font-weight:bold&quot;&gt;Code / données séparés&lt;/div&gt;&lt;div style=&quot;font-size:11px;line-height:1.2;margin-top:4px;color:#2457A7&quot;&gt;DISQUES VIRTUELS · ADR 0041&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.25;margin-top:6px;color:#526581&quot;&gt;hda : système + paquet /app&lt;br&gt;hdb : données /app/var&lt;/div&gt;" tooltip="T1 #236 : descripteur v2 ; rootfs et paquet composent les partitions de hda. La graine initialise hdb avec vérification d’empreinte. Les écritures hors /app/var sont perdues au boot à froid. Le paquet entre dans la liaison d’instantané. Le geste de mise à jour et la comparaison de schémas restent à T2.">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#C7D4E5;strokeWidth=1.3;" vertex="1" parent="1">
            <mxGeometry x="800" y="765" width="280" height="105" as="geometry" />
          </mxCell>
        </object>
