# Sans barre : couvre aussi node_modules quand un worktree l'adosse par lien symbolique à
# l'installation d'un autre arbre de travail (#127) — la barre ne filtre que les répertoires.
# La contrepartie est acceptée : un fichier portant ce nom n'a pas d'usage légitime ici. Les
# autres entrées gardent leur barre, la décision n'est actée que pour celle-ci.
node_modules
coverage/
dist/
playwright-report/
test-results/
reports/
.claude/
.env
.DS_Store
Thumbs.db

# Artefacts de l'image de reference : construits, jamais commites (le manifeste l'est).
artifacts/
apps/reference/tmp/
apps/reference/log/
apps/reference/var/
apps/reference/.bundle/
apps/reference/vendor/bundle/
vendor/v86/artefacts/
